{"$schema":"http://json-schema.org/draft-07/schema#","definitions":{"agent_slot":{"properties":{"note":{"type":"string"},"result_ref":{"description":"Repo-relative path to results/<agent>.json","type":["string","null"]},"role":{"description":"This agent's fixed lane for this task. Never changes the shared task.","type":"string"},"status":{"description":"unavailable = agent did not respond in time or integration down. Recorded, never fabricated.","enum":["pending","done","failed","unavailable","skipped"],"type":"string"},"updated_at":{"format":"date-time","type":["string","null"]}},"required":["role","status","result_ref","note","updated_at"],"type":"object"},"approval":{"properties":{"at":{"format":"date-time","type":["string","null"]},"by":{"type":["string","null"]},"status":{"enum":["not_required","pending","approved","rejected"],"type":"string"},"text_sha1":{"description":"SHA1 of the exact approved text. Execution must match it byte-for-byte.","type":["string","null"]}},"required":["status","by","at","text_sha1"],"type":"object"}},"description":"One envelope per task. Every input adapter produces this. Every agent reads this. No side channels.","properties":{"approvals":{"properties":{"michael_buffer":{"$ref":"#/definitions/approval"},"michael_send":{"$ref":"#/definitions/approval"},"michael_spend":{"$ref":"#/definitions/approval"},"spark_editorial":{"$ref":"#/definitions/approval"}},"required":["spark_editorial","michael_send","michael_buffer","michael_spend"],"type":"object"},"audit":{"description":"Append-only human-readable lines. Every stage change, approval, execution, and failure lands here.","items":{"type":"string"},"type":"array"},"created_at":{"format":"date-time","type":"string"},"dial_command":{"description":"Fast Response v8 dial 1-9, AUTO_TRIAGE, or null when not a rebuttal task.","type":["string","null"]},"dispatch":{"additionalProperties":false,"properties":{"claude":{"$ref":"#/definitions/agent_slot"},"openclaw":{"$ref":"#/definitions/agent_slo